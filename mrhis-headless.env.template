#!/bin/bash
# MRHIS Headless Environment Configuration Template (Jinja2)
#
# This template is suitable for rendering with Ansible's `template` module
# and is used to produce a local headless env file when running
# `ansible-playbook playbooks/render-templates-local.yml`.
#
# Security: chmod 600 on the rendered file.

# =============================================================================
# CORE CREDENTIALS  (required for almost all menu choices)
# =============================================================================
{%- set _rh_user = (RH_USER if (RH_USER is defined and RH_USER) else (RH_USERNAME if (RH_USERNAME is defined and RH_USERNAME) else '')) -%}
{%- set _rh_pass = (RH_PASS if (RH_PASS is defined and RH_PASS) else (RH_PASSWORD if (RH_PASSWORD is defined and RH_PASSWORD) else '')) -%}
{%- set _admin_user = (GLOBAL_ADMIN if (GLOBAL_ADMIN is defined and GLOBAL_ADMIN) else (ADMIN_USER if (ADMIN_USER is defined and ADMIN_USER) else 'admin')) -%}
{%- set _admin_pass = (AAP_ADMIN_PASSWORD if (AAP_ADMIN_PASSWORD is defined and AAP_ADMIN_PASSWORD) else (ADMIN_PASSWORD if (ADMIN_PASSWORD is defined and ADMIN_PASSWORD) else (AAP_ADMIN_PASS if (AAP_ADMIN_PASS is defined and AAP_ADMIN_PASS) else ''))) -%}
{%- set _root_pass = (ROOT_PASS if (ROOT_PASS is defined and ROOT_PASS) else _admin_pass) -%}

RH_USER="{{ _rh_user }}"
RH_PASS="{{ _rh_pass }}"

# Local admin user and password for every managed VM
ADMIN_USER="{{ _admin_user }}"
ADMIN_PASS="{{ _admin_pass }}"
MRHIS_INSTALLER_EMAIL="{{ MRHIS_INSTALLER_EMAIL | default(_admin_user ~ '@' ~ (DOMAIN | default('example.com'))) }}"

# Root password for kickstart-provisioned VMs
ROOT_PASS="{{ _root_pass }}"

# =============================================================================
# IdM CONFIGURATION
# =============================================================================
IDM_IP="{{ IDM_IP | default('10.168.128.3') }}"
IDM_HOSTNAME="{{ IDM_HOSTNAME | default('idm.example.com') }}"
IDM_ALIAS="{{ IDM_ALIAS | default('idm') }}"
DOMAIN="{{ DOMAIN | default('example.com') }}"
IDM_DS_PASS="{{ IDM_DS_PASS | default(IDM_DS_PASSWORD | default('')) }}"

# =============================================================================
# SATELLITE CONFIGURATION
# =============================================================================
SAT_IP="{{ SAT_IP | default('10.168.128.1') }}"
SAT_HOSTNAME="{{ SAT_HOSTNAME | default('satellite.example.com') }}"
SAT_ALIAS="{{ SAT_ALIAS | default('satellite') }}"
SAT_ORG="{{ SAT_ORG | default('Default_Organization') }}"
SAT_LOC="{{ SAT_LOC | default('Default_Location') }}"
SAT_ADMIN_PASS="{{ SAT_ADMIN_PASS | default(AAP_ADMIN_PASSWORD | default(_admin_pass)) }}"

# =============================================================================
# AAP CONFIGURATION
# =============================================================================
AAP_IP="{{ AAP_IP | default('10.168.128.2') }}"
AAP_HOSTNAME="{{ AAP_HOSTNAME | default('aap.example.com') }}"
AAP_ALIAS="{{ AAP_ALIAS | default('aap') }}"
AAP_ADMIN_PASS="{{ AAP_ADMIN_PASS | default(AAP_ADMIN_PASSWORD | default(_admin_pass)) }}"

# Red Hat Automation Hub offline token
HUB_TOKEN="{{ HUB_TOKEN | default(AAP_HUB_TOKEN | default('')) }}"

# =============================================================================
# PLATFORM / PROVIDER (optional)
# Set MRHIS_TARGET_PLATFORM to one of: libvirt, vmware, nutanix, openshift,
# openshift-virt, aws, azure, gcp, baremetal. Provide provider-specific
# credentials below when deploying to cloud or remote platforms.
# =============================================================================
# MRHIS_TARGET_PLATFORM="libvirt"

# libvirt
# LIBVIRT_URI="qemu:///system"
# LIBVIRT_POOL="default"

# VMware
# VMWARE_HOST="vcenter.example.com"
# VMWARE_USER="administrator@vsphere.local"
# VMWARE_PASS=""

# Nutanix
# NUTANIX_ENDPOINT="https://prism.example.com:9440"
# NUTANIX_USER=""
# NUTANIX_PASS=""

# OpenShift
# OPENSHIFT_API_URL="https://api.ocp.example.com:6443"
# OPENSHIFT_TOKEN=""

# AWS
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Azure
# AZURE_SUBSCRIPTION_ID=""
# AZURE_TENANT_ID=""
# AZURE_CLIENT_ID=""
# AZURE_CLIENT_SECRET=""

# GCP
# GCP_PROJECT=""
# GCP_SERVICE_ACCOUNT_JSON="/path/to/service-account.json"

# Bare metal / BMC
# BMC_IP=""
# BMC_USER=""
# BMC_PASS=""

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================
HOST_INT_IP="{{ HOST_INT_IP | default('10.168.0.1') }}"
CMDB_ENDPOINT_IP="{{ CMDB_ENDPOINT_IP | default('10.168.128.44') }}"

# =============================================================================
# VM RESOURCE CONFIGURATION (optional)
# =============================================================================
# IDM_VCPUS="4"
# IDM_MEMORY_MB="16384"

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# DEMO_MODE="0"
