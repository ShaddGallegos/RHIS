.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
*.bak
*.backup
*.old

# Secrets
*.key
*.pem
*.secret
*.SAMPLE

# MiniRHIS generated files — contain resolved IPs, passwords from env.yml.
# Ignore all generated files in these trees, but keep SAMPLE/sample variants tracked.
host_vars/**
!host_vars/**/
!host_vars/**/*[sS][aA][mM][pP][lL][eE]*
!host_vars/README.md

inventory/**
!inventory/**/
!inventory/**/*[sS][aA][mM][pP][lL][eE]*
!inventory/README.md

# Local fallback workspace synced from provisioner container (may include vault data)
local/roles/**

# MiniRHIS runtime secrets and generated container-side artifacts
# Generated per-deployment host_vars (Ansible auto-resolves by FQDN hostname).
# Created by generate_minirhis_host_vars() — do NOT commit these files.
local/vars/external_inventory/host_vars/*.yml
!local/vars/external_inventory/host_vars/README.md

# Generated inventory files that may contain resolved live values — keep only
# the placeholder template variants (hosts / hosts.yml) tracked.
local/vars/external_inventory/hosts.generated

local/vars/ssh/id_rsa
local/vars/ssh/id_rsa.pub
local/vars/ssh/known_hosts
local/vars/vault/.vaultpass.txt
local/vars/vault/.vaultpass.container*
local/vars/vault/env.yml
local/vars/vault/minirhis-ansible.cfg
local/vars/vault/ansible-provisioner.log
local/vars/vault/manifest.zip
local/vars/vault/facts-cache/

# MiniRHIS generated runtime version markers
local/version24.txt
local/version25.txt

# MiniRHIS runtime package retry output
failed_packages.txt

# Local helper scripts
.sync-minirhis.sh
.GitHubRepoManager.sh
tools/hammer_time.sh

# Local/generated documentation artifacts
docs/

# Local reports and sweep artifacts
reports/
hammers_sweep_report.md

# Local/generated model training artifacts
training_data/

# Local Ansible env/vault and sensitive artifacts
.ansible/
.ansible/conf/
.ansible/conf/env.yml
.ansible/conf/.vaultpass*
env.yml
**/env.yml
*.vault
*.vaultpass
*.pem
*.key

# User-collected artifacts and logs (do not commit runtime artifacts)
artifacts_user/
artifacts_user/**
