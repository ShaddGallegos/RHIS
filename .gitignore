# Ansible runtime caches/state
.ansible/conf/facts-cache/
~/.ansible/
# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
.nyc_output

# Dependency directories
node_modules/
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
*.bak
*.backup
*.old

# Secrets
*.key
*.pem
*.secret
*.SAMPLE

# MiniRHIS generated files — contain resolved IPs, passwords from env.yml.
# Ignore all generated files in these trees, but keep SAMPLE/sample variants tracked.
host_vars/**
!host_vars/**/
!host_vars/**/*[sS][aA][mM][pP][lL][eE]*

inventory/**
!inventory/**/
!inventory/**/*[sS][aA][mM][pP][lL][eE]*
!inventory/README.md

# Local fallback workspace synced from provisioner container (may include vault data)
container/roles/**

# MiniRHIS runtime secrets and generated container-side artifacts
container/vars/ssh/id_rsa
container/vars/ssh/id_rsa.pub
container/vars/ssh/known_hosts
container/vars/vault/.vaultpass.txt
container/vars/vault/.vaultpass.container*
container/vars/vault/env.yml
container/vars/vault/rhis-ansible.cfg
container/vars/vault/ansible-provisioner.log
container/vars/vault/manifest.zip
container/vars/vault/facts-cache/

# MiniRHIS generated runtime version markers
container/version24.txt
container/version25.txt

# MiniRHIS runtime package retry output
failed_packages.txt

# Local helper scripts
.sync-rhis.sh
.GitHubRepoManager.sh
tools/hammer_time.sh

# Local/generated documentation artifacts
docs/

# Local reports and sweep artifacts
reports/
hammers_sweep_report.md
